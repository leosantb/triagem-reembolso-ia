# LLM (Ollama local)
OLLAMA_HOST=http://localhost:11434
LLM_MODEL=qwen2.5:7b

# Triagem: stub | local | http
#   stub  -> sem triagem real
#   local -> importa ../src/triagem.py (exige: pip install -e ".[dev,local-triage]")
#   http  -> POST {TRIAGE_URL}/triagem (no docker compose: http://triagem:8001)
TRIAGE_MODE=local
TRIAGE_URL=http://localhost:8001

# Política
AUTO_APPROVE_LIMIT_BRL=80
